{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% extends "template.njk" %}

{% block content %}
  <h1 class="govuk-heading-xl">Task Details</h1>

  <form id="save-task-form" action="/task/save/{{ itemData.id }}" method="post">
    {% call govukInsetText() %}
      Details for Task: {{ itemData.id }} {{ itemData.title }}
      <br />
      {% if isEditingStatus %}
        To discard your changes click the cancel button below
      {% else %}
        To edit the status for this task click the button below
      {% endif %}
      <br /><br />

      <div style="display: flex; gap: 15px; align-items: flex-start;">
          <div style="width: 160px;">
              <button type="submit" formaction="/create-task" class="govuk-button govuk-!-width-full">Create New</button>
          </div>

          <div style="width: 160px;">
              {% if isEditingStatus %}
                  <button type="submit" formaction="/items/{{ itemData.id }}/editStatus/{{ isEditingStatus }}" formmethod="post" class="govuk-button govuk-button--secondary govuk-!-width-full">Cancel Edit</button>
              {% else %}
                  <button type="submit" formaction="/items/{{ itemData.id }}/editStatus/{{ isEditingStatus }}" formmethod="post" class="govuk-button govuk-!-width-full">Edit Status</button>
              {% endif %}
          </div>

          {% if isEditingStatus %}
              <div style="width: 160px;">
                  <button type="submit" class="govuk-button govuk-!-width-full">Save</button>
              </div>
          {% endif %}

          <div style="width: 160px;">
              <button type="submit" formaction="/tasks/{{ itemData.id }}/delete" formmethod="get" class="govuk-button govuk-button--warning govuk-!-width-full">Delete</button>
          </div>

          <div style="width: 160px;">
              <a href="/home/{{ itemData.id }}" class="govuk-button govuk-!-width-full">Back</a>
          </div>
      </div>
    {% endcall %}

    {{
      govukInput({
          label: {
              text: "Task Id"
          },
          id: "txtTaskId",
          name: "TaskId",
          value: itemData.id,
          attributes: {
              readonly: "readonly"
          }
      })
    }}

    {{
      govukInput({
          label: {
              text: "Title"
          },
          id: "txtTitle",
          name: "Title",
          value: itemData.title,
          attributes: {
              readonly: "readonly"
          }
      })
    }}
    {% from "govuk/components/textarea/macro.njk" import govukTextarea %}

    {{
      govukSelect({
          id: "selectStatus",
          name: "status",
          errorMessage: { text: statusError } if statusError else null,
          label: {
              text: "Task Status"
          },
          items: [
              {
                  value: "0001",
                  text: "Not Started",
                  selected: true if itemData.statusCode == "0001" else false
              },
              {
                  value: "0002",
                  text: "In Progress",
                  selected: true if itemData.statusCode == "0002" else false
              },
              {
                  value: "0003",
                  text: "On hold",
                  selected: true if itemData.statusCode == "0003" else false
              },
              {
                  value: "0004",
                  text: "Complete",
                  selected: true if itemData.statusCode == "0004" else false
              }
          ],
          disabled: not isEditingStatus
      })
    }}

    {{
      govukTextarea({
          name: "txtTaskDescription",
          id: "taskDescription",
          label: {
              text: "Task Description"
          },
          hint: {
              text: "This should explain what you need to do to complete this task"
          },
          value: itemData.description,
          attributes: {
              readonly: "readonly"
          }
      })
    }}

    {{
      govukDateInput({
          id: "dateTaskDueDate",
          namePrefix: "task-due-date",
          fieldset: {
              legend: {
              text: "Due Date"
              }
          },
          hint: {
              text: "This is when this task should be completed by"
          },
          items: [
              {
                  name: "day",
                  classes: "govuk-input--width-2",
                  value: itemData.dueDate.slice(8, 10),
                  attributes: {
                          readonly: "readonly"
                      }
              },
              {
                  name: "month",
                  classes: "govuk-input--width-2",
                  value: itemData.dueDate.slice(5, 7),
                  attributes: {
                          readonly: "readonly"
                      }
              },
              {
                  name: "year",
                  classes: "govuk-input--width-4",
                  value: itemData.dueDate.slice(0, 4),
                  attributes: {
                          readonly: "readonly"
                      }
              }
          ]
      })
    }}
  </form>

  {{
    govukBackLink({
        text: "Back",
        href: "/home/" ~ itemData.id
    })
  }}
{% endblock %}
